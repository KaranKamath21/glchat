# ── GitLab ──────────────────────────────────────────────────────────────
# Personal Access Token with the `api` scope (create/update issues, comments).
# Base URL is set in core/config.json (gitlab.base_url), NOT here.
GITLAB_TOKEN=your_gitlab_personal_access_token_here

# ── LLM: Groq (primary) ─────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── LLM: AWS Bedrock (fallback) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# ── Conversation memory (PostgreSQL) ────────────────────────────────────
# LangGraph checkpointer persists chat history here. Format:
#   postgresql://user:password@host:5432/dbname
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/gitlab_ai_agent
